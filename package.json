{
  "name": "corpus",
  "version": "1.0.0",
  "description": "TEM nanoparticle metrology, dataset curation and instance-segmentation toolkit built with Electron, OpenCV and Python.",
  "homepage": "https://github.com/RxWhizz/Corpus#readme",
  "main": "main.js",
  "build": {
    "productName": "Corpus",
    "appId": "org.corpus.tem",
    "asar": false,
    "files": [
      "**/*",
      "!data/**",
      "!reports/**",
      "!runs/**",
      "!dist/**",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "linux": {
      "category": "Science",
      "maintainer": "RxWhizz <corpus-maintainer@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        "dir"
      ],
      "description": "TEM nanoparticle metrology, dataset curation and instance-segmentation toolkit built with Electron, OpenCV and Python.",
      "synopsis": "TEM nanoparticle metrology and dataset curation"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RxWhizz/Corpus.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node training/run_python.js -m pytest tests -q",
    "lint": "node training/run_python.js -m ruff check .",
    "smoke": "node training/run_python.js -m corpus.dev.smoke",
    "check:node": "node --check main.js && node --check render.js && node --check training/run_python.js",
    "demo:build": "node training/run_python.js scripts/build_demo_dataset.py",
    "demo:check": "node training/run_python.js scripts/build_demo_dataset.py --check",
    "demo:expected": "node training/run_python.js scripts/build_demo_expected.py",
    "demo:expected:check": "node training/run_python.js scripts/build_demo_expected.py --check",
    "validate": "node training/run_python.js -m corpus.validation",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux dir --x64",
    "dist:linux:deb": "electron-builder --linux deb --x64",
    "package:ubuntu": "npm run dist:linux && tar -czf dist/Corpus-1.0.0-linux-x64.tar.gz -C dist linux-unpacked",
    "package:ubuntu:appimage": "electron-builder --linux AppImage --x64",
    "training:synthetic-bundle": "node training/run_python.js training/package_colab_bundle.py --synthetic-smoke --clean",
    "training:package": "node training/run_python.js training/package_colab_bundle.py --coco data/annotations/cvat_coco_imported.json --clean",
    "training:audit": "node training/run_python.js training/audit_training_dataset.py --dataset data/training/yolo_seg",
    "training:registry": "node training/run_python.js training/dataset_registry.py",
    "training:discovery": "node training/run_python.js training/dataset_discovery_report.py",
    "training:download": "node training/run_python.js training/download_datasets.py --all-approved",
    "training:normalize": "node training/run_python.js training/normalize_dataset.py --dataset corpus_exact_au_sio2",
    "training:splits": "node training/run_python.js training/build_splits.py --manifest data/normalized/corpus_exact_au_sio2/manifest.csv --out data/normalized/corpus_exact_au_sio2/manifest.split.csv",
    "training:audit-splits": "node training/run_python.js training/audit_split_leakage.py --manifest data/training/yolo_seg/manifest.csv --require-test --exact-test-only",
    "training:train": "node training/run_python.js training/train_corpus_seg.py --config configs/training/au_sio2_v1.yaml",
    "training:benchmark": "node training/run_python.js training/benchmark_segmentation_backends.py --coco data/annotations/cvat_coco_imported.json",
    "training:prepare-emps": "node training/run_python.js training/prepare_emps_yolo_seg.py --clean",
    "training:package-emps": "node training/run_python.js training/package_colab_bundle.py --yolo-dir data/training/emps_yolo_seg --clean --min-au-core 0 --min-sio2-outer 0",
    "training:normalize-bam-tio2": "node training/run_python.js training/normalize_dataset.py --dataset agglomerated_non_spherical_em --input data/external/agglomerated_non_spherical_em --clean",
    "training:prepare-bam-tio2": "node training/run_python.js training/prepare_particle_yolo_seg.py --coco data/normalized/agglomerated_non_spherical_em/annotations.json --out data/training/agglomerated_non_spherical_em_yolo_seg --clean",
    "training:audit-bam-tio2": "node training/run_python.js training/audit_training_dataset.py --dataset data/training/agglomerated_non_spherical_em_yolo_seg --min-images 40 --report reports/bam_tio2_yolo_dataset_audit.md",
    "training:audit-bam-tio2-splits": "node training/run_python.js training/audit_split_leakage.py --manifest data/training/agglomerated_non_spherical_em_yolo_seg/manifest.csv --require-test --report reports/bam_tio2_split_leakage_audit.md",
    "training:normalize-psdi-gold": "node training/run_python.js training/normalize_dataset.py --dataset psdi_gold_tem_2026 --input data/external/psdi_gold_tem_2026 --clean",
    "training:prepare-psdi-gold": "node training/run_python.js training/prepare_particle_yolo_seg.py --coco data/normalized/psdi_gold_tem_2026/annotations.json --out data/training/psdi_gold_tem_2026_yolo_seg --clean",
    "training:audit-psdi-gold": "node training/run_python.js training/audit_training_dataset.py --dataset data/training/psdi_gold_tem_2026_yolo_seg --min-images 1674 --report reports/psdi_gold_yolo_dataset_audit.md",
    "training:audit-psdi-gold-splits": "node training/run_python.js training/audit_split_leakage.py --manifest data/training/psdi_gold_tem_2026_yolo_seg/manifest.csv --require-test --near-duplicate-distance -1 --report reports/psdi_gold_split_leakage_audit.md",
    "training:audit-psdi-gold-near": "node training/run_python.js training/audit_split_leakage.py --manifest data/training/psdi_gold_tem_2026_yolo_seg/manifest.csv --require-test --report reports/psdi_gold_split_leakage_audit_perceptual.md",
    "training:combine-particle": "node training/run_python.js training/combine_yolo_datasets.py --dataset data/training/psdi_gold_tem_2026_yolo_seg --dataset data/training/agglomerated_non_spherical_em_yolo_seg --out data/training/particle_pretrain_psdi_bam_yolo_seg --clean",
    "training:train-particle-pretrain": "node training/run_python.js training/train_corpus_seg.py --config configs/training/particle_pretrain_psdi_bam.yaml --force",
    "training:rocm-particle-pretrain": "bash scripts/run_particle_pretrain_rocm.sh configs/training/particle_pretrain_psdi_bam.yaml",
    "training:rocm-particle-pretrain-0.4.0": "bash scripts/run_particle_pretrain_rocm.sh configs/training/particle_pretrain_psdi_bam_rocm_v0_4_0.yaml",
    "training:rocm-particle-pretrain-dual": "bash scripts/run_particle_pretrain_rocm_dual.sh configs/training/particle_pretrain_psdi_bam.yaml",
    "figures:triage": "node training/run_python.js training/triage_pdf_figures.py --clean",
    "figures:audit-review": "node training/run_python.js training/audit_triage_review.py",
    "figures:separate-tem": "node training/run_python.js training/separate_review_marked_tem.py --clean"
  },
  "devDependencies": {
    "electron": "^26.1.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@electron/remote": "^2.0.11",
    "chart.js": "^4.4.0",
    "echarts": "^5.4.3"
  },
  "author": {
    "name": "Tesla_SHT",
    "email": "corpus@localhost"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RxWhizz/Corpus/issues"
  },
  "keywords": [
    "electron-microscopy",
    "tem",
    "nanoparticles",
    "computer-vision",
    "image-analysis",
    "materials-science",
    "opencv",
    "instance-segmentation",
    "scientific-software",
    "yolo"
  ],
  "maintainers": [
    {
      "name": "RxWhizz",
      "url": "https://github.com/RxWhizz"
    }
  ]
}
